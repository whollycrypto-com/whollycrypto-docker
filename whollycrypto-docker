#!/bin/bash
# This entry point also works before Python has been installed.
set -Eeuo pipefail
entry_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
case "${1:---help}" in
  setup|resume|check|prerequisites)
    action=$1; shift
    case "$action" in
      setup) exec bash "$entry_root/install.sh" "$@" ;;
      resume) exec bash "$entry_root/install.sh" --resume "$@" ;;
      check) exec bash "$entry_root/install.sh" --check "$@" ;;
      prerequisites) exec bash "$entry_root/install.sh" --prerequisites-only "$@" ;;
    esac ;;
  --help|-h)
    printf '%s\n' 'Wholly Crypto Docker 1.1.1' \
      '  setup         Guided fresh setup; offers to install missing prerequisites' \
      '  check         Read-only host prerequisite check' \
      '  prerequisites Install missing host tools only (asks before changes)' \
      '  resume        Safely continue an interrupted setup' \
      '  status | logs | doctor | backup | update | start | stop' \
      '  runtime-update Upgrade container code after draining background work' \
      '  cli COMMAND   Run a merchant CLI command inside the container' \
      '  Setup options: --yes (approve prerequisite installation only)' ;;
  *)
    for interpreter in python3 python3.13 python3.12 python3.11 python3.10 python3.9; do
      if command -v "$interpreter" >/dev/null 2>&1 && "$interpreter" -c 'import sys; raise SystemExit(sys.version_info < (3, 9))' 2>/dev/null; then
        exec "$interpreter" "$entry_root/host/cli.py" "$@"
      fi
    done
    printf '%s\n' 'Python 3.9+ is missing. Run ./whollycrypto-docker prerequisites first.' >&2
    exit 1 ;;
esac
